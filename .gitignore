# Variáveis de ambiente e segredos locais
.env
.env.*
!.env.example

# Volumes locais do PostgreSQL (caso mapeados em pasta local)
.pgdata/
pgdata/

# Arquivos temporários de sistema operacional e IDEs
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Logs temporários de execução (evidências oficiais em evidencias/ são versionadas)
*.tmp
*.log
!evidencias/*.log
!evidencias/*.txt
