# Padronizar quebras de linha em LF para garantir reprodutibilidade entre Windows/Linux/macOS
# e preservar o hash SHA-256 exato do Chinook e a execução de scripts .sh no container Docker.
* text=auto eol=lf

*.sh text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf

# Arquivos binários
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
